{
  "expo": {
    "name": "CoachFlow",
    "slug": "coachflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "coachflow",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.idan.coachflow"
    },
    "android": {
      "package": "com.idan.coachflow",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store"
    ],
    "extra": {
      "supportsRTL": true,
      "eas": {
        "projectId": "dad06d81-16b5-4bf1-ba4c-138a1f38ca82"
      }
    },
    "owner": "idanrodri",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dad06d81-16b5-4bf1-ba4c-138a1f38ca82"
    }
  }
}
